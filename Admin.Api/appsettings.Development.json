
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "SecretKey": "CSgXV0uksKkw270tvV7gPltl6YAJyrJDzM04mBqrVL4=",
    "Issuer": "AnimalManagement.UserService",
    "Audience": "AnimalManagement.Api"
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "animal-route": {
        "ClusterId": "animal-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/animal/{**catch-all}"
        }
      },
      "translation-route": {
        "ClusterId": "translation-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/translation/{**catch-all}"
        }
      },
      "user-register-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/user/register",
          "Methods": [ "POST" ]
        }
      },
      "user-login-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/user/login",
          "Methods": [ "POST" ]
        }
      },
      "rotate-refresh-token-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/user/rotate",
          "Methods": [ "POST" ]
        }
      },
      "user-protected-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/user/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "animal-cluster": {
        "Destinations": {
          "animal-service": {
            "Address": "https://localhost:7090/"
          }
        }
      },
      "translation-cluster": {
        "Destinations": {
          "translation-service": {
            "Address": "https://localhost:7224/"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "https://localhost:7273/"
          }
        }
      }
    }
  }
}
